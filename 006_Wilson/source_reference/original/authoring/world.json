      ],
      "epistemic_status": "record_limit",
      "known_by_role_ids": [],
      "is_synthetic_fact": false,
      "record_limit_method": "Absence in supplied opinion, not absence in original proceedings."
    },
    {
      "fact_id": "F14",
      "text": "来源未提供A的定罪前完整个人证言、不在场说法、事故原因辩解或毒理专长；角色不得替A补写承认饮酒、否认驾驶或技术解释。",
      "source_id": "source16",
