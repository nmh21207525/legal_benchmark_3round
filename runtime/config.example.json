{
  "backend": "codex_cli",
  "api": {
    "provider": "packy",
    "base_url": "https://cf.api.fan/v1",
    "key_env": "PACKY_API_KEY"
  },
  "models": {
    "lawyer": "gpt-6-sol",
    "environment": "gpt-5.6-sol"
  },
  "defense_models": {
    "seed": "doubao-seed-evolving",
    "deepseek": "deepseek-flash",
    "opus": "claude-opus-5-5",
    "gpt": "gpt-5.6-sol"
  },
  "reasoning_effort": "medium",
  "max_input_chars": 700000,
  "max_output_tokens": 16384,
  "max_model_calls": 240,
  "max_lawyer_actions": 100,
  "default_actions_per_role_per_stage": 3,
  "timeout_seconds": 300,
  "codex": {
    "executable": ".tools/codex",
    "progress": true,
    "diagnostics": false
  }
}
